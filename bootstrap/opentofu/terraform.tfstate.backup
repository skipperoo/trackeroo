 - apt-get purge -y isc-dhcp-client\n  - apt-get purge -y isc-dhcp-common\n  # Configure unattended upgrades\n  - echo 'Unattended-Upgrade::Automatic-Reboot \"false\";' \u003e\u003e /etc/apt/apt.conf.d/50unattended-upgrades\n  - echo 'Unattended-Upgrade::Remove-Unused-Dependencies \"true\";' \u003e\u003e /etc/apt/apt.conf.d/50unattended-upgrades\n  - systemctl enable unattended-upgrades\n  # Optimize system for K3s\n  - echo 'net.bridge.bridge-nf-call-iptables = 1' \u003e\u003e /etc/sysctl.conf\n  - echo 'net.ipv4.ip_forward = 1' \u003e\u003e /etc/sysctl.conf\n  - sysctl -p\n# System configuration\nbootcmd:\n  - echo 'Initializing system...' \u003e /var/log/cloud-init-bootcmd.log\n# Power state (optional - uncomment if you want to reboot after setup)\n# power_state:\n#   mode: reboot\n#   message: \"Rebooting after cloud-init setup\"\n#   timeout: 30\n#   condition: true\n# Final message\nfinal_message: |\n  ========================================\n  VM setup completed successfully!\n  ========================================\n  System Information:\n  - User: k3s-admin\n  - SSH: Key-based authentication enabled\n  - Automatic updates: Enabled\n  To connect:\n    ssh k3s-admin@\u003cvm-ip\u003e\n  System is ready for K3s deployment!\n  ========================================\n"},"sensitive_attributes":[],"private":"bnVsbA=="}]},{"mode":"managed","type":"libvirt_volume","name":"vm_base_disks","provider":"provider[\"registry.opentofu.org/dmacvicar/libvirt\"]","instances":[{"index_key":"k3s-node-hermes","schema_version":0,"attributes":{"base_volume_id":null,"base_volume_name":null,"base_volume_pool":null,"format":"qcow2","id":"/home/gigio/Data/fast_storage/VMs/disks/k3s_cluster/k3s-node-hermes-base.qcow2","name":"k3s-node-hermes-base.qcow2","pool":"k3s_cluster","size":3221225472,"source":"cloud-init/debian-13-cloud-init.qcow2","xml":[]},"sensitive_attributes":[],"private":"bnVsbA=="}]}],"check_results":null}
