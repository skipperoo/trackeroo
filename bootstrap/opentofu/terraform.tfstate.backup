{"version":4,"terraform_version":"1.10.3","serial":16,"lineage":"083909e0-20d0-2ac0-a67f-16fc683f4fad","outputs":{"vm_names":{"value":["k3s-node-achilles","k3s-node-hermes","k3s-node-odysseus","k3s-server-cronus","k3s-server-hyperion","k3s-server-oceanus"],"type":["tuple",["string","string","string","string","string","string"]]}},"resources":[{"mode":"managed","type":"libvirt_cloudinit_disk","name":"vm_cloudinit","provider":"provider[\"registry.opentofu.org/dmacvicar/libvirt\"]","instances":[{"index_key":"k3s-node-achilles","schema_version":0,"attributes":{"id":"/var/lib/libvirt/images/k3s-node-achilles-cloudinit.iso;52b7beba-4a41-4fb2-9b7e-508599c233bc","meta_data":"instance-id: k3s-node-achilles-01\nlocal-hostname: k3s-node-achilles\n","name":"k3s-node-achilles-cloudinit.iso","network_config":"network: \n  version: 2\n  ethernets:\n    enp1s0:\n      dhcp4: true\n    enp2s0:\n      dhcp4: true\n","pool":"default","user_data":"#cloud-config\n# Basic system configuration\ntimezone: Europe/Rome\nlocale: en_US.UTF-8\n# User configuration\nusers:\n  - name: k3s-admin\n    passwd: $6$rounds=4096$v0k4/WEZZLQnikFD$1b5obdvCiCz.BffcjSUPS4MTPV7Ro6cr8J87HWpyonOQX7rX823rap/1mk/.plRFnMlhOvGLkuoWrgfCArZOb.\n    lock_passwd: false\n    groups: sudo\n    shell: /bin/bash\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII6/cdK31gsONZhnyDTUf1/lyVY5mg23jyWurMzyLITJ sdcadmin@loginnode\n    bashrc: |\n  # Create .bashrc with proper content\n  - |\n    cat \u003e /home/k3s-admin/.bashrc \u003c\u003c 'EOF'\n    # ~/.bashrc: executed by bash(1) for non-login shells.\n\n    # If not running interactively, don't do anything\n    case $- in\n        *i*) ;;\n          *) return;;\n    esac\n\n    # don't put duplicate lines or lines starting with space in the history.\n    HISTCONTROL=ignoreboth\n\n    # append to the history file, don't overwrite it\n    shopt -s histappend\n\n    # for setting history length see HISTSIZE and HISTFILESIZE in bash(1)\n    HISTSIZE=1000\n    HISTFILESIZE=2000\n\n    # check the window size after each command and, if necessary,\n    # update the values of LINES and COLUMNS.\n    shopt -s checkwinsize\n\n    # make less more friendly for non-text input files, see lesspipe(1)\n    [ -x /usr/bin/lesspipe ] \u0026\u0026 eval \"$(SHELL=/bin/sh lesspipe)\"\n\n    # set variable identifying the chroot you work in (used in the prompt below)\n    if [ -z \"${debian_chroot:-}\" ] \u0026\u0026 [ -r /etc/debian_chroot ]; then\n        debian_chroot=$(cat /etc/debian_chroot)\n    fi\n\n    # set a fancy prompt (non-color, unless we know we \"want\" color)\n    case \"$TERM\" in\n        xterm-color|*-256color) color_prompt=yes;;\n    esac\n\n    if [ -n \"$force_color_prompt\" ]; then\n        if [ -x /usr/bin/tput ] \u0026\u0026 tput setaf 1 \u003e\u0026/dev/null; then\n            color_prompt=yes\n        else\n            color_prompt=\n        fi\n    fi\n\n    if [ \"$color_prompt\" = yes ]; then\n        PS1='${debian_chroot:+($debian_chroot)}\\[\\033[01;32m\\]\\u@\\h\\[\\033[00m\\]:\\[\\033[01;34m\\]\\w\\[\\033[00m\\]\\$ '\n    else\n        PS1='${debian_chroot:+($debian_chroot)}\\u@\\h:\\w\\$ '\n    fi\n    unset color_prompt force_color_prompt\n\n    # If this is an xterm set the title to user@host:dir\n    case \"$TERM\" in\n    xterm*|rxvt*)\n        PS1=\"\\[\\e]0;${debian_chroot:+($debian_chroot)}\\u@\\h: \\w\\a\\]$PS1\"\n        ;;\n    *)\n        ;;\n    esac\n\n    # enable color support of ls and also add handy aliases\n    if [ -x /usr/bin/dircolors ]; then\n        test -r ~/.dircolors \u0026\u0026 eval \"$(dircolors -b ~/.dircolors)\" || eval \"$(dircolors -b)\"\n        alias ls='ls --color=auto'\n        alias dir='dir --color=auto'\n        alias vdir='vdir --color=auto'\n    fi\n\n    # Alias definitions.\n    # You may want to put all your additions into a separate file like\n    # ~/.bash_aliases, instead of adding them here directly.\n    if [ -f ~/.bash_aliases ]; then\n        . ~/.bash_aliases\n    fi\n\n    # enable programmable completion features (you don't need to enable\n    # this, if it's already enabled in /etc/bash.bashrc and /etc/profile\n    # sources /etc/bash.bashrc).\n    if ! shopt -oq posix; then\n      if [ -f /usr/share/bash-completion/bash_completion ]; then\n        . /usr/share/bash-completion/bash_completion\n      elif [ -f /etc/bash_completion ]; then\n        . /etc/bash_completion\n      fi\n    fi\n    EOF\n\n# SSH configuration\nssh_pwauth: false\ndisable_root: true\nssh_deletekeys: true\nssh_genkeytypes: [\"rsa\", \"ecdsa\", \"ed25519\"]\n# Package updates and installations\npackage_update: true\npackage_upgrade: true\npackages:\n  - curl\n  - wget\n  - git\n  - htop\n  - vim\n  - nano\n  - tree\n  - zip\n  - unzip\n  - build-essential\n  - apt-transport-https\n  - ca-certificates\n  - gnupg\n  - lsb-release\n  - unattended-upgrades\n  - conntrack\n  - ipset\n  - ipvsadm\n  - jq\n  - nfs-common\n  - open-iscsi\n# Write configuration files\nwrite_files:\n  # Custom motd\n  - path: /etc/motd\n    content: |\n      ================================\n      SUBEMELARADIO - K3S WORKER NODE\n      ================================\n      Please think twice before running any commands and always check paths!\n      System configured with cloud-init\n      Useful commands:\n        - kubectl get nodes\n        - systemctl status k3s\n        - journalctl -u k3s -f\n    permissions: \"0644\"\n\nruncmd:\n  # Update system\n  - apt-get update\n  - apt-get upgrade -y\n  - apt-get autoremove -y\n  - apt-get autoclean\n  - apt-get purge -y isc-dhcp-client\n  - apt-get purge -y isc-dhcp-common\n  # Configure unattended upgrades\n  - echo 'Unattended-Upgrade::Automatic-Reboot \"false\";' \u003e\u003e /etc/apt/apt.conf.d/50unattended-upgrades\n  - echo 'Unattended-Upgrade::Remove-Unused-Dependencies \"true\";' \u003e\u003e /etc/apt/apt.conf.d/50unattended-upgrades\n  - systemctl enable unattended-upgrades\n  # Optimize system for K3s\n  - echo 'net.bridge.bridge-nf-call-iptables = 1' \u003e\u003e /etc/sysctl.conf\n  - echo 'net.ipv4.ip_forward = 1' \u003e\u003e /etc/sysctl.conf\n  - sysctl -p\n# System configuration\nbootcmd:\n  - echo 'Initializing system...' \u003e /var/log/cloud-init-bootcmd.log\n# Power state (optional - uncomment if you want to reboot after setup)\n# power_state:\n#   mode: reboot\n#   message: \"Rebooting after cloud-init setup\"\n#   timeout: 30\n#   condition: true\n# Final message\nfinal_message: |\n  ========================================\n  VM setup completed successfully!\n  ========================================\n  System Information:\n  - User: k3s-admin\n  - SSH: Key-based authentication enabled\n  - Automatic updates: Enabled\n  To connect:\n    ssh k3s-admin@\u003cvm-ip\u003e\n  System is ready for K3s deployment!\n  ========================================\n"},"sensitive_attributes":[],"private":"bnVsbA=="},{"index_key":"k3s-node-hermes","schema_version":0,"attributes":{"id":"/var/lib/libvirt/images/k3s-node-hermes-cloudinit.iso;1945ab8f-17ff-4351-82e6-7a52a338615f","meta_data":"instance-id: k3s-node-hermes-01\nlocal-hostname: k3s-node-hermes\n","name":"k3s-node-hermes-cloudinit.iso","network_config":"network: \n  version: 2\n  ethernets:\n    enp1s0:\n      dhcp4: true\n    enp2s0:\n      dhcp4: true\n","pool":"default","user_data":"#cloud-config\n# Basic system configuration\ntimezone: Europe/Rome\nlocale: en_US.UTF-8\n# User configuration\nusers:\n  - name: k3s-admin\n    passwd: $6$rounds=4096$v0k4/WEZZLQnikFD$1b5obdvCiCz.BffcjSUPS4MTPV7Ro6cr8J87HWpyonOQX7rX823rap/1mk/.plRFnMlhOvGLkuoWrgfCArZOb.\n    lock_passwd: false\n    groups: sudo\n    shell: /bin/bash\n    sudo: [\"ALL=(ALL) NOPASSWD:ALL\"]\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII6/cdK31gsONZhnyDTUf1/lyVY5mg23jyWurMzyLITJ sdcadmin@loginnode\n    bashrc: |\n  # Create .bashrc with proper content\n  - |\n    cat \u003e /home/k3s-admin/.bashrc \u003c\u003c 'EOF'\n    # ~/.bashrc: executed by bash(1) for non-login shells.\n\n    # If not running interactively, don't do anything\n    case $- in\n        *i*) ;;\n          *) return;;\n    esac\n\n    # don't put duplicate lines or lines starting with space in the history.\n    HISTCONTROL=ignoreboth\n\n    # append to the history file, don't overwrite it\n    shopt -s histappend\n\n    # for setting history length see HISTSIZE and HISTFILESIZE in bash(1)\n    HISTSIZE=1000\n    HISTFILESIZE=2000\n\n    # check the window size after each command and, if necessary,\n    # update the values of LINES and COLUMNS.\n    shopt -s checkwinsize\n\n    # make less more friendly for non-text input files, see lesspipe(1)\n    [ -x /usr/bin/lesspipe ] \u0026\u0026 eval \"$(SHELL=/bin/sh lesspipe)\"\n\n    # set variable identifying the chroot you work in (used in the prompt below)\n    if [ -z \"${debian_chroot:-}\" ] \u0026\u0026 [ -r /etc/debian_chroot ]; then\n        debian_chroot=$(cat /etc/debian_chroot)\n    fi\n\n    # set a fancy prompt (non-color, unless we know we \"want\" color)\n    case \"$TERM\" in\n        xterm-color|*-256color) color_prompt=yes;;\n    esac\n\n    if [ -n \"$force_color_prompt\" ]; then\n        if [ -x /usr/bin/tput ] \u0026\u0026 tput setaf 1 \u003e\u0026/dev/null; then\n            color_prompt=yes\n        else\n            color_prompt=\n        fi\n    fi\n\n    if [ \"$color_prompt\" = yes ]; then\n        PS1='${debian_chroot:+($debian_chroot)}\\[\\033[01;32m\\]\\u@\\h\\[\\033[00m\\]:\\[\\033[01;34m\\]\\w\\[\\033[00m\\]\\$ '\n    else\n        PS1='${debian_chroot:+($debian_chroot)}\\u@\\h:\\w\\$ '\n    fi\n    unset color_prompt force_color_prompt\n\n    # If this is an xterm set the title to user@host:dir\n    case \"$TERM\" in\n    xterm*|rxvt*)\n        PS1=\"\\[\\e]0;${debian_chroot:+($debian_chroot)}\\u@\\h: \\w\\a\\]$PS1\"\n        ;;\n    *)\n        ;;\n    esac\n\n    # enable color support of ls and also add handy aliases\n    if [ -x /usr/bin/dircolors ]; then\n        test -r ~/.dircolors \u0026\u0026 eval \"$(dircolors -b ~/.dircolors)\" || eval \"$(dircolors -b)\"\n        alias ls='ls --color=auto'\n        alias dir='dir --color=auto'\n        alias vdir='vdir --color=auto'\n    fi\n\n    # Alias definitions.\n    # You may want to put all your additions into a separate file like\n    # ~/.bash_aliases, instead of adding them here directly.\n    if [ -f ~/.bash_aliases ]; then\n        . ~/.bash_aliases\n    fi\n\n    # enable programmable completion features (you don't need to enable\n    # this, if it's already enabled in /etc/bash.bashrc and /etc/profile\n    # sources /etc/bash.bashrc).\n    if ! shopt -oq posix; then\n      if [ -f /usr/share/bash-completion/bash_completion ]; then\n        . /usr/share/bash-completion/bash_completion\n      elif [ -f /etc/bash_completion ]; then\n        . /etc/bash_completion\n      fi\n    fi\n    EOF\n\n# SSH configuration\nssh_pwauth: false\ndisable_root: true\nssh_deletekeys: true\nssh_genkeytypes: [\"rsa\", \"ecdsa\", \"ed25519\"]\n# Package updates and installations\npackage_update: true\npackage_upgrade: true\npackages:\n  - curl\n  - wget\n  - git\n  - htop\n  - vim\n  - nano\n  - tree\n  - zip\n  - unzip\n  - build-essential\n  - apt-transport-https\n  - ca-certificates\n  - gnupg\n  - lsb-release\n  - unattended-upgrades\n  - conntrack\n  - ipset\n  - ipvsadm\n  - jq\n  - nfs-common\n  - open-iscsi\n# Write configuration files\nwrite_files:\n  # Custom motd\n  - path: /etc/motd\n    content: |\n      ================================\n      SUBEMELARADIO - K3S WORKER NODE\n      ================================\n      Please think twice before running any commands and always check paths!\n      System configured with cloud-init\n      Useful commands:\n        - kubectl get nodes\n        - systemctl status k3s\n        - journalctl -u k3s -f\n    permissions: \"0644\"\n\nruncmd:\n  # Update system\n  - apt-get update\n  - apt-get upgrade -y\n  - apt-get autoremove -y\n  - apt-get autoclean\n  - apt-get purge -y isc-dhcp-client\n  - apt-get purge -y isc-dhcp-common\n  # Configure unattended upgrades\n  - echo 'Unattended-Upgrade::Automatic-Reboot \"false\";' \u003e\u003e /etc/apt/apt.conf.d/50unattended-upgrades\n  - echo 'Unattended-Upgrade::Remove-Unused-Dependencies \"true\";' \u003e\u003e /etc/apt/apt.conf.d/50unattended-upgrades\n  - systemctl enable unattended-upgrades\n  # Optimize system for K3s\n  - echo 'net.bridge.bridge-nf-call-iptables = 1' \u003e\u003e /etc/sysctl.conf\n  - echo 'net.ipv4.ip_forward = 1' \u003e\u003e /etc/sysctl.conf\n  - sysctl -p\n# System configuration\nbootcmd:\n  - echo 'Initializing system...' \u003e /var/log/cloud-init-bootcmd.log\n# Power state (optional - uncomment if you want to reboot after setup)\n# power_state:\n#   mode: reboot\n#   message: \"Rebooting after cloud-init setup\"\n#   timeout: 30\n#   condition: true\n# Final message\nfinal_message: |\n  ========================================\n  VM setup completed successfully!\n  ========================================\n  System Information:\n  - User: k3s-admin\n  - SSH: Key-based authentication enabled\n  - Automatic updates: Enabled\n  To connect:\n    ssh k3s-admin@\u003cvm-ip\u003e\n  System is ready for K3s deployment!\n  ========================================\n"},"sensitive_attributes":[],"private":"bnVsbA=="},{"index_key":"k3s-node-odysseus","schema_version":0,"attributes":{"id":"/var/lib/libvirt/images/k3s-node-odysseus-cloudinit.iso;568c5a7f-2114-410d-9ff3-d89a12a2691e","meta_data":"instance-id: k3s-node-odysseus-01\nlocal-hostname: k3s-node-odysseus\n","name":"k3s-node-odysseus-cloudinit.iso","network_config":"network: \n  version: 2\n  ethernets:\n    enp1s0:\n      dhcp4: true\n    enp2s0:\n      dhcp4: true\n","pool":"default","user_data":"#cloud-config\n# Basic system configuration\ntimezone: Europe/Rome\nlocale: en_US.UTF-8\n# User configuration\nuse