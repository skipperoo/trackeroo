#!/bin/bash
# set -e

K3S_ROLE="server"
K3S_NODE_IP="{{ hostvars[inventory_hostname].internal_ip }}"
K3S_TOKEN_FILE="{{ k3s_token_file }}"

# If this is the first server, initialize cluster
{% if inventory_hostname == groups['servers'][0] %}
echo "Installing first K3s server (cluster-init)..."
K3S_CLUSTER_INIT="--cluster-init"
K3S_SERVER=""
{% else %}
echo "Installing additional K3s server..."
K3S_CLUSTER_INIT=""
# K3S_SERVER="--server https://{{ hostvars[groups['servers'][0]].internal_ip }}:6443"
K3S_SERVER="--server https://{{ kube_api_vip }}:6443"
{% endif %}

# Install K3s
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="{{ k3s_version }}" \
K3S_KUBECONFIG_MODE="644" \
{% if inventory_hostname != groups['servers'][0] %}
K3S_TOKEN="${K3S_TOKEN}" \
{% endif %}
sh -s - ${K3S_ROLE} ${K3S_CLUSTER_INIT} ${K3S_SERVER} \
  --node-ip ${K3S_NODE_IP} \
  --advertise-address ${K3S_NODE_IP} \
  --disable-agent \
  --tls-san {{ kube_api_vip }} \
  --flannel-iface {{ internal_interface }} \
  --disable-cloud-controller \
  --disable servicelb \
  --node-taint "workload-type=apps"

# This is to prevent any workload from being scheduled on the servers.
# --node-taint CriticalAddonsOnly=true:NoSchedule \
echo "K3s server installation completed"
