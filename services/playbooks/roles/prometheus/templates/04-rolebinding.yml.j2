apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ prometheus_app_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ prometheus_app_name }}
subjects:
  - kind: ServiceAccount
    name: {{ prometheus_app_name }}
    namespace: {{ prometheus_namespace }}
