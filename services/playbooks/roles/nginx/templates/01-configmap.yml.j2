apiVersion: v1
kind: ConfigMap
metadata:
  name: nginx-conf
data:
  nginx.conf: |
    events {}
    http {
      server {
        listen 80;
        server_name _;

        location /dashboards/ {
          # Strip the /dashboards prefix before proxying
          rewrite ^/dashboards/(.*)$ /$1 break;

          # Proxy to the Grafana service
          proxy_pass http://grafana.grafana.svc.cluster.local:3000;

          # Set headers for proxying
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;

          # Required for Grafana Live (WebSockets)
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection "upgrade";
        }

        location / {
          # Default handling for other paths (e.g., return 404 or a default page)
          return 404;
        }
      }
    }
