apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: "{{ rabbitmq_app_name }}-peer-finder-binding"
  namespace: "{{ rabbitmq_namespace }}"
subjects:
- kind: ServiceAccount
  name: "{{ rabbitmq_app_name }}-sa"
roleRef:
  kind: Role
  name: "{{ rabbitmq_app_name }}-peer-finder"
  apiGroup: rbac.authorization.k8s.io
