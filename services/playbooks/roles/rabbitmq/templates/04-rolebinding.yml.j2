apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: "{{ rabbitmq_app_name }}"
  namespace: "{{ rabbitmq_namespace }}"
subjects:
- kind: ServiceAccount
  name: "{{ rabbitmq_app_name }}"
roleRef:
  kind: Role
  name: "{{ rabbitmq_app_name }}"
  apiGroup: rbac.authorization.k8s.io
