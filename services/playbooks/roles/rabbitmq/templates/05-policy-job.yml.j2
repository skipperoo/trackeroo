---
apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ rabbitmq_app_name }}-policy-setter"
  namespace: "{{ rabbitmq_namespace }}"
spec:
  template:
    spec:
      restartPolicy: OnFailure
      containers:
        - name: rabbitmq-policy-setter
          image: "{{ rabbitmq_image }}"
          env:
            - name: RABBITMQ_ERLANG_COOKIE
              valueFrom:
                secretKeyRef:
                  name: "{{ rabbitmq_app_name }}-secrets"
                  key: rabbitmq_erlang_cookie
            - name: RABBITMQ_USER
              valueFrom:
                secretKeyRef:
                  name: "{{ rabbitmq_app_name }}-secrets"
                  key: rabbitmq_admin_user
            - name: RABBITMQ_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ rabbitmq_app_name }}-secrets"
                  key: rabbitmq_admin_password
          command:
            - /bin/sh
            - -c
            - |
              echo "RabbitMQ is up. Applying quorum queue policy..."
              rabbitmqctl --longnames -n rabbit@rabbitmq-0.rabbitmq-headless.{{ rabbitmq_namespace }}.svc.cluster.local \
                set_policy {{ rabbitmq_ha_policy_name }} \
                "{{ rabbitmq_ha_policy_pattern }}" \
                '{{ rabbitmq_ha_policy_definition }}' \
                --apply-to queues

              echo "Policy applied successfully!"
              rabbitmqctl --longnames -n rabbit@rabbitmq-0.rabbitmq-headless.{{ rabbitmq_namespace }}.svc.cluster.local \
                list_policies
