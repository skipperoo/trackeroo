apiVersion: apps/v1
kind: Deployment
metadata:
  name: flink-jobmanager
  labels:
    app: flink-jobmanager
spec:
  replicas: 1
  selector:
    matchLabels:
      app: flink-jobmanager
  template:
    metadata:
      labels:
        app: flink-jobmanager
    spec:
      containers:
      - name: jobmanager
        image: {{ flink_image }}
        args: ["jobmanager"]
        ports:
          - containerPort: {{ flink_jobmanager_port }}
        env:
          - name: FLINK_PROPERTIES
            value: |
              jobmanager.rpc.address: flink-jobmanager
        readinessProbe:
          httpGet:
            path: /overview
            port: {{ flink_jobmanager_port }}
          initialDelaySeconds: 10
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: flink-jobmanager
spec:
  selector:
    app: flink-jobmanager
  ports:
    - name: rpc
      port: {{ flink_jobmanager_port }}
      targetPort: {{ flink_jobmanager_port }}
      protocol: TCP
  type: ClusterIP
