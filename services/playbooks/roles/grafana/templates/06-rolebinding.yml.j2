apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: "{{ grafana_app_name }}-metrics-reader"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: "{{ grafana_app_name }}-metrics-reader"
subjects:
- kind: ServiceAccount
  name: "{{ grafana_app_name }}"
  namespace: "{{ grafana_namespace }}"
